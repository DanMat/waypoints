{
  "name": "@danmat/waypoints-core",
  "version": "0.1.0",
  "description": "Privacy-first travel-log engine: turn a Google Timeline export into sanitized, city-level places and stats. Browser-safe, dataset-agnostic.",
  "keywords": [
    "travel",
    "google-timeline",
    "location-history",
    "geocoding",
    "privacy"
  ],
  "license": "MIT",
  "author": "DanMat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DanMat/waypoints.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prep:data": "node scripts/prep-data.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0"
  }
}
