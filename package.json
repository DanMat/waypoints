{
  "name": "waypoints",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "pnpm --filter @waypoints/web build && pnpm --filter @waypoints/server deploy",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "biome check --write .",
    "typecheck": "turbo typecheck",
    "prep:data": "pnpm --filter @waypoints/pipeline prep:data",
    "aggregate": "tsx packages/pipeline/src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0"
  }
}
